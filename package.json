{
  "name": "topcard",
  "version": "0.1.0",
  "description": "Scheduling human attention across parallel agents.",
  "license": "MIT",
  "homepage": "https://github.com/ZIXT233/TopCard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIXT233/TopCard.git"
  },
  "bugs": {
    "url": "https://github.com/ZIXT233/TopCard/issues"
  },
  "keywords": [
    "topcard",
    "agent",
    "queue",
    "pi",
    "cli"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "topcard": "bin/topcard.js",
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "app",
    "bin",
    "components",
    "hooks",
    "lib",
    "public",
    "instrumentation.ts",
    "proxy.ts",
    "next.config.ts",
    "postcss.config.mjs",
    "tailwind.config.ts",
    "tsconfig.json",
    ".next",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"desktop/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "desktop:dev": "electron . --dev",
    "desktop:build": "node desktop/build.mjs",
    "desktop:build:force": "node desktop/build.mjs --force",
    "desktop:start": "electron .",
    "desktop:package": "npm run desktop:build && electron-builder --config desktop/builder.cjs",
    "test:desktop": "node e2e/desktop.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "ansi_up": "^6.0.6",
    "js-yaml": "^5.2.3",
    "next": "16.3.1",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "semver": "7.8.0",
    "undici": "8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "main": "desktop/main.cjs"
}
